{
	"$schema": "https://opencode.ai/config.json",
	"model": "openrouter/google/gemini-3.7-flash",
	"default_agent": "build",
	"permission": {
		"bash": {
			"*": "ask",
			"echo *": "allow",
			"cat *": "allow",
			"sed *": "allow",
			"find *": "allow",
			"ls *": "allow",
			"grep *": "allow",
			"rg *": "allow",
			"head *": "allow",
			"tail *": "allow",
			"wc *": "allow",
			"sort *": "allow",
			"uniq *": "allow",
			"awk *": "allow",
			"jq *": "allow",
			"diff *": "allow",
			"tree *": "allow",
			"which *": "allow",
			"printf *": "allow",
			"read *": "allow",
			"pwd": "allow",
			"pwd *": "allow",
			"nl *": "allow",
			"type *": "allow",
			"command -v *": "allow",
			"date *": "allow",
			"true *": "allow",
			"false *": "allow",
			"make clean": "allow",
			"make test": "allow",
			"make build": "allow",
			"git describe *": "allow",
			"git check-ignore *": "allow",
			"git log *": "allow",
			"git tag *": "allow",
			"git status *": "allow",
			"git branch *": "allow",
			"git config --get *": "allow",
			"git config --list*": "allow",
			"git config -l*": "allow",
			"git remote -v *": "allow",
			"git rev-list *": "allow",
			"git reflog *": "allow",
			"git ls-files *": "allow",
			"git diff *": "allow",
			"git show *": "allow",
			"git blame *": "allow",
			"git rev-parse *": "allow",
			"git ls-tree *": "allow",
			"git pull *": "allow",
			"dig *": "allow",
			"glab ci lint *": "allow",
			"git clone *": "allow",
			"paste *": "allow",
			"yq *": "allow",
			"git add *": "allow",
			"git fetch *": "allow",
			"docker ps *": "allow",
			"docker inspect *": "allow",
			"docker logs *": "allow",
			"git stash list *": "allow"
		}
	},
	"instructions": ["~/.config/opencode/AGENTS.md"]
}
